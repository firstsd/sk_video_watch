# Local access on this Mac. Edit the installed copy, then run ./scripts/server-macos restart.
MATCHDAY_HOST=127.0.0.1
MATCHDAY_PORT=8000
MATCHDAY_AUTH_ENABLED=false

# To require login, set MATCHDAY_AUTH_ENABLED=true and fill in both values.
# Values are literal. Enter passwords without surrounding quotes.
MATCHDAY_USERNAME=
MATCHDAY_PASSWORD=
