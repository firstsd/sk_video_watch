# All values are whole seconds. Restart Matchday after changing them.
# The live target and threshold are relative to the provider's live playlist.

# Preferred playback delay. Short playlists may require starting closer to live.
MATCHDAY_LIVE_TARGET_SECONDS=150

# Delay beyond which the player can seek forward. Keep greater than the live target.
MATCHDAY_LIVE_MAX_SECONDS=180

# Downloaded video to aim for ahead of playback. The available playlist, download
# speed, and browser memory limit the actual reserve. Startup does not wait for it.
MATCHDAY_FORWARD_BUFFER_SECONDS=180

# Played video to keep for rewinding. Use 0 to trim as soon as segments allow.
MATCHDAY_BACK_BUFFER_SECONDS=30
