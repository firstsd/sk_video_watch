# Keep localhost for access through SSH or Tailscale Serve.
# For direct access from your home LAN, change MATCHDAY_HOST to 0.0.0.0.
MATCHDAY_HOST=127.0.0.1
MATCHDAY_PORT=8000

# Keep authentication enabled on the server. Disable only for a trusted local setup.
MATCHDAY_AUTH_ENABLED=true

# Required when authentication is enabled: both values must be set.
# Use a long, unique password. Quote values containing spaces or #.
MATCHDAY_USERNAME=
MATCHDAY_PASSWORD=
