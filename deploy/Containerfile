# AlmaLinux/RHEL host: run the browser on a supported Debian userspace.
# Install the Playwright version and matching Chromium from uv.lock together.
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MATCHDAY_HOST=0.0.0.0 \
    MATCHDAY_PORT=8000

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --python /usr/local/bin/python
RUN .venv/bin/python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 matchday \
    && useradd --uid 10001 --gid 10001 --create-home matchday
COPY app ./app

USER 10001:10001
# Fail the build if the full Chromium runtime cannot launch as the app user.
RUN .venv/bin/python -c 'from app.setup_browser import check_browser; check_browser()'
EXPOSE 8000
CMD ["sh", "-c", "exec /app/.venv/bin/python -m uvicorn app.main:app --host \"$MATCHDAY_HOST\" --port \"$MATCHDAY_PORT\""]
