# Rootless Podman reads this from ~/.config/matchday/matchday.env.
# Host address and host port are controlled by PublishPort in matchday.container.
# Keep the container's internal listener at 0.0.0.0:8000.
MATCHDAY_AUTH_ENABLED=true
MATCHDAY_USERNAME=
MATCHDAY_PASSWORD=
# Values here use Podman's env-file format, not systemd's quoting rules.
# Write values literally, without surrounding quotes: those quotes become part
# of the value. A password can contain spaces or # after the equals sign.
